# Agent IAM System - 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# JWT
JWT_SECRET=change-me-to-a-random-secret
TOKEN_EXPIRE_SECONDS=3600

# 飞书应用凭证 - 企业数据Agent
FEISHU_ENTERPRISE_APP_ID=cli_xxxxxxxxxxxx
FEISHU_ENTERPRISE_APP_SECRET=your_app_secret_here

# 飞书应用凭证 - 飞书文档助手Agent
FEISHU_DOC_APP_ID=cli_xxxxxxxxxxxx
FEISHU_DOC_APP_SECRET=your_app_secret_here

# 飞书 API
FEISHU_API_BASE=https://open.feishu.cn/open-apis

# SearXNG 搜索引擎
SEARXNG_URL=http://192.168.1.248:18935

# 火山引擎 LLM API（可选）
LLM_API_KEY=your_api_key_here
LLM_MODEL_ID=your_model_id_here
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# Agent 密钥
DOC_AGENT_SECRET=change-me
ENTERPRISE_AGENT_SECRET=change-me
EXTERNAL_AGENT_SECRET=change-me
AI_ANALYST_SECRET=change-me
